{
  "name": "internal-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/assistant-sdk"
  ],
  "scripts": {
    "prepare": "nuxt prepare",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --port 3001",
    "build": "nuxt build",
    "build:assistant-sdk": "npm run build --workspace @internal-ai-assistant/assistant-sdk",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "npm run test:unit && npm run test:component && npm run test:contract",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nuxt/icon": "^2.3.1",
    "@nuxt/ui": "^4.9.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.8",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  }
}
