{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.vue",
    "src/mountAssistantWidget.ts",
    "src/types/**/*.ts"
  ],
  "exclude": [
    "src/context/**",
    "src/events/**",
    "src/lifecycle/**",
    "src/request/**",
    "src/runtime/**",
    "src/session/**",
    "src/transport/**"
  ]
}
